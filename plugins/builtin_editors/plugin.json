{
    "id": "builtin_editors",
    "name": "数据录入编辑器",
    "version": "1.0.0",
    "author": "演播室2",
    "description": "内置编辑器插件：选手 / 队伍 / 解说信息录入面板（由控制面板按 slot=editor 动态装载）",
    "api_version": "2.0.0",
    "dependencies": [],
    "load_priority": 0,
    "hot_reload": { "enabled": true, "mode": "auto", "debounce_ms": 300 },
    "watch": ["panels/", "scripts/"],
    "provides": {
        "panels": [
            {
                "id": "PlayerEditor",
                "slot": "editor",
                "order": 10,
                "name": "选手信息录入",
                "scene": "panels/player_editor.tscn"
            },
            {
                "id": "TeamEditor",
                "slot": "editor",
                "order": 20,
                "name": "队伍信息录入",
                "scene": "panels/team_editor.tscn"
            },
            {
                "id": "AnnouncerEditor",
                "slot": "editor",
                "order": 30,
                "name": "解说信息录入",
                "scene": "panels/announcer_editor.tscn"
            }
        ]
    }
}